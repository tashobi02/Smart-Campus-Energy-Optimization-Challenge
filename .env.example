# GridWise — Environment Variables
# Copy to .env and fill in real values

LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=google/gemini-2.5-flash
PORT=8000

# Transport stub: auto | canned | malformed | off
# "auto" serves a canned payload whenever LLM_API_KEY is empty, so the whole
# team can work without a provider. "malformed" returns a deliberately broken
# payload for guardrail testing.
LLM_STUB_MODE=auto
