# GridWise — environment variable contract. Names and placeholders only.
# Copy to .env and fill in a real key. .env is git-ignored; this file is not.

LLM_PROVIDER=openai
LLM_API_KEY=replace-with-your-key
LLM_MODEL=gpt-4.1-mini
PORT=8000

# Always call the provider. The default `auto` silently falls back to a canned
# payload when the key is missing or invalid, which makes a broken LLM look
# like a passing test run.
LLM_STUB_MODE=off
