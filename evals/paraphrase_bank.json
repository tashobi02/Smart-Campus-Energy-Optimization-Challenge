  "_meta": {
    "title": "GridWise — paraphrase eval bank (PLAND2 3.6)",
    "purpose": "Hidden judge cases will paraphrase the public notes. This bank is the only way to find out which conventions the prompt gets wrong before the judge does.",
    "built_from": "tests/fixtures/public_cases.json — every public note, reworded 3-5 ways",
    "battery_ref": "resolved against the named case's battery in tests/fixtures/public_cases.json; percentage reserves depend on capacity_kwh",
    "truth_note": "note_index and explanation are omitted — judge.interpretation.compare_note does not read them",
    "conventions": {
      "clock_24h": "24-hour clock, e.g. 18:00",
      "clock_ampm": "AM/PM, e.g. 6 PM",
      "clock_words": "spelled out, e.g. from six until nine in the evening",
      "clock_noon_midnight": "noon / midday / midnight instead of a number",
      "window_between": "between X and Y",
      "window_from_until": "from X until/through Y",
      "window_during": "during the X-Y window / across the X and Y hours",
      "window_starting": "for N hours starting at X",
      "pct_remaining": "states the fraction that remains, e.g. drops to 20%",
      "pct_reduction": "states the fraction lost, e.g. an 80% reduction",
      "fraction_words": "worded fraction, e.g. one-fifth of normal output",
      "reserve_absolute": "reserve given in kWh",
      "reserve_percentage": "reserve given as a percentage of capacity",
      "reserve_fraction": "reserve given as a worded fraction of capacity",
      "cap_wording": "grid cap phrased as ceiling/limit rather than must not exceed",
      "distractor": "carries no directive",
      "operational_sounding": "distractor that uses operational vocabulary and numbers"
    }
  },
